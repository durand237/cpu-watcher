# -----------------------------------------------------------------------------
# Operating-system and editor files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo

# Keep shared VS Code configuration in Git; ignore only machine-local files.
.vscode
*.code-workspace
.idea/
*.iml
.classpath
.project
.settings/

# -----------------------------------------------------------------------------
# Secrets and local environment files
# -----------------------------------------------------------------------------
# Never commit environment files or local cloud credential directories.
.env
.env.*
!.env.example
!.env.*.example
.aws/
**/.aws/

# Private keys and common certificate/key containers.
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
**/secrets/

# -----------------------------------------------------------------------------
# Terraform
# -----------------------------------------------------------------------------
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Safe templates can be committed and copied locally as needed.
!*.tfvars.example
!*.tfvars.json.example

# Keep .terraform.lock.hcl committed: it pins provider versions and checksums.

# -----------------------------------------------------------------------------
# Java and Gradle
# -----------------------------------------------------------------------------
target/
**/target/
.gradle/
**/.gradle/
.gradle-home/
**/.gradle-home/
build/
**/build/
out/
**/out/
bin/
**/bin/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------------
# Node.js / React
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
**/coverage/
.cache/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Logs and local runtime data
# -----------------------------------------------------------------------------
*.log
.collector.pid
logs/
**/logs/
tmp/
**/tmp/

# Docker-created local data and the conventional local Compose override.
docker-data/
**/docker-data/
docker-compose.override.yml
compose.override.yml
