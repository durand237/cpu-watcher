# Copy this file to terraform.tfvars only when you need to override defaults.
# terraform.tfvars is intentionally ignored by Git.

aws_region          = "eu-central-1"
project_name        = "cpu-watcher"
environment         = "dev"
release_version     = "unreleased"
instance_type       = "t3.micro"
root_volume_size_gib = 30
collector_api_key    = "replace-with-a-long-random-collector-key"

# The EC2 user-data script clones this public repository and builds the collector
# as a host-native systemd service on first boot.
collector_repository_url = "https://github.com/durand237/cpu-watcher.git"
collector_repository_ref = "main"

# Leave null to use Session Manager rather than exposing SSH.
ssh_allowed_cidr = null
